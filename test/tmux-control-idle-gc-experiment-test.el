;;; -*- lexical-binding: t; -*-
(require 'ert)
(require 'tmux-control-idle-gc-experiment)
(ert-deftest tmux-control-idle-gc-test-requires-quiet-and-allocation ()
  (let ((tmux-control-idle-gc--quiet-seconds 1.0)
        (tmux-control-idle-gc--cons-budget 100))
    (should (tmux-control-idle-gc--eligible-p 1.1 100 nil))
    (should-not (tmux-control-idle-gc--eligible-p .9 100 nil))
    (should-not (tmux-control-idle-gc--eligible-p 1.1 99 nil))
    (should-not (tmux-control-idle-gc--eligible-p 1.1 100 t))))
(ert-deftest tmux-control-idle-gc-test-stop-preserves-unrelated-hooks ()
  (let ((post-command-hook '(ignore tmux-control-idle-gc--note-command))
        (post-gc-hook '(ignore tmux-control-idle-gc--note-collection))
        (tmux-control-idle-gc--timer nil)
        (tmux-control-idle-gc--buffer 'fixture))
    (tmux-control-idle-gc-experiment-stop)
    (should (equal post-command-hook '(ignore)))
    (should (equal post-gc-hook '(ignore)))
    (should-not tmux-control-idle-gc--buffer)))
